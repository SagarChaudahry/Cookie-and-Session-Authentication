@model DbFirstCRUD.Data.Entities.PaginatedDesignationViewModel

@{
    ViewData["Title"] = "Designation List";
}

<h1>Designation List</h1>

<!-- Table to display designations -->
<table class="table table-striped">
    <thead>
        <tr>
            <th>Designation ID</th>
            <th>Designation Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Designations != null && Model.Designations.Count > 0)
        {
            foreach (var designation in Model.Designations)
            {
                <tr>
                    <td>@designation.DesignationId</td>
                    <td>@designation.DesignationName</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@designation.DesignationId" class="btn btn-info">View</a>
                        <a asp-action="Edit" asp-route-id="@designation.DesignationId" class="btn btn-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@designation.DesignationId" class="btn btn-danger"
                           onclick="return confirm('Are you sure you want to delete this designation?');">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">No designations available.</td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination Controls -->
<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage - 1)">Previous</a>
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@i">@i</a>
            </li>
        }

        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage + 1)">Next</a>
        </li>
    </ul>
</nav>

<div class="text-center">
    <p>Showing page @Model.CurrentPage of @Model.TotalPages.</p>
</div>

<!-- Add New Designation Button -->
<div class="text-right">
    <a asp-action="Create" class="btn btn-success">Add New Designation</a>
</div>
