@model List<DbFirstCRUD.Data.Entities.Employees>

@{
    Layout = null; // No layout for PDF rendering
}

<h2>Employee List</h2>

<table border="1" cellpadding="5" cellspacing="0">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Designation</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var emp in Model)
        {
            <tr>
                <td>@emp.Name</td>
                <td>@emp.Email</td>
                <td>@emp.DepartmentName</td>
                <td>@emp.DesignationName</td>
            </tr>
        }
    </tbody>
</table>
