<a href="@Url.Action("ExportToPdf", "Employee")" class="btn btn-danger">Export to PDF</a>

<!-- Pagination Controls -->

<form asp-action="Index" asp-route-pageSize="@Model.PageSize" method="get" class="form-inline mb-3">
    <label for="pageSize" class="mr-2">Show:</label>
    <select name="pageSize" class="form-control mr-2" onchange="this.form.submit()">
        <option value="10" selected="@(Model.PageSize == 10 ? "selected" : "")">10</option>
        <option value="20" selected="@(Model.PageSize == 20 ? "selected" : "")">20</option>
        <option value="30" selected="@(Model.PageSize == 30 ? "selected" : "")">30</option>
        <option value="40" selected="@(Model.PageSize == 40 ? "selected" : "")">40</option>
        <option value="50" selected="@(Model.PageSize == 50 ? "selected" : "")">50</option>
    </select>
    <span>rows per page</span>
</form>

<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        <!-- Previous Button -->
        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage - 1)" tabindex="-1">Previous</a>
        </li>

        <!-- Page Number Links -->
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@i">@i</a>
            </li>
        }

        <!-- Next Button -->
        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.CurrentPage + 1)">Next</a>
        </li>
    </ul>
</nav>

<div class="text-center">
    <p>Showing page @Model.CurrentPage of @Model.TotalPages.</p>
</div>

