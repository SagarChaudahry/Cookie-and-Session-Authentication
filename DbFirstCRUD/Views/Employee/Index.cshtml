                @model DbFirstCRUD.Data.Entities.PaginatedEmployeeViewModel

@{
    ViewData["Title"] = "Employee List";
}

<h1>Employee List</h1>

<!-- Table to display employees -->
<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Designation</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Employees != null && Model.Employees.Count > 0)
        {
            foreach (var employee in Model.Employees)
            {
                <tr>
                    <td>@employee.EmployeeName</td>
                    <td>@employee.Email</td>
                    <td>@employee.DepartmentName</td>
                    <td>@employee.DesignationName</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@employee.EmployeeId" class="btn btn-info">View</a>
                        <a asp-action="Edit" asp-route-id="@employee.EmployeeId" class="btn btn-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@employee.EmployeeId" class="btn btn-danger">Delete</a>
                    </td>
                </tr>
            }
        }
    
    </tbody>
</table>




